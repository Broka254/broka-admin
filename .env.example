# Server-only FastAPI endpoint. Never expose a token or secret through NEXT_PUBLIC_*.
BROKA_API_URL=https://api.broka.co.ke
BROKA_API_TIMEOUT=10000

# Optional: set only after confirming the FastAPI logout contract.
# BROKA_AUTH_LOGOUT_PATH=/auth/token/revoke

# Keep secure/SameSite=None cookies in production. Set to false only for local HTTP.
# BROKA_COOKIE_SECURE=true
