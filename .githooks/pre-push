#!/bin/sh
# Runs the test suite before every push and blocks the push if it fails.
# Enabled by `pnpm install` (the "prepare" script points core.hooksPath here).
# PRE_PUSH_TEST_CMD overrides the command; tests/pre-push-hook.test.mjs uses it.
# Exceptional bypass (e.g. pushing a WIP branch): git push --no-verify
cd "$(dirname "$0")/.." || exit 1

cmd="${PRE_PUSH_TEST_CMD:-pnpm test}"
echo "pre-push: running '$cmd' (bypass in an emergency with: git push --no-verify)"
if ! sh -c "$cmd"; then
  echo "pre-push: tests failed, push blocked." >&2
  exit 1
fi
