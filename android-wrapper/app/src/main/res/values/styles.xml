<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BrokaAdmin" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/surface_ink</item>
        <item name="android:statusBarColor">@color/surface_ink</item>
        <item name="android:navigationBarColor">@color/surface_ink</item>
        <item name="android:colorPrimary">@color/broka_violet</item>
        <item name="android:colorAccent">@color/broka_violet</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="ErrorText" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="RetryButton" parent="android:Widget.Material.Button">
        <item name="android:background">@color/broka_violet</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:elevation">2dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
